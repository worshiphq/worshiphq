// SchoolOS (working title) — multi-tenant school management for Nursery → JHS (Ghana)
// Every tenant-owned table carries `schoolId`. All queries MUST be scoped by it (see src/lib/db.ts).
// Money is Decimal(12,2) in GHS. Dates without time-of-day use @db.Date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  SCHOOL_ADMIN
  HEADTEACHER
  TEACHER
  BURSAR
  REGISTRAR
  PARENT
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum Stage {
  NURSERY
  KG
  PRIMARY
  JHS
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  TRANSFERRED
  GRADUATED
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  REPEATED
  GRADUATED
  WITHDRAWN
}

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum CalendarDayType {
  HOLIDAY
  CLOSURE
  SPECIAL_DAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ScaleKind {
  SCORE_BAND // numeric score → grade (Primary/JHS)
  RATING // teacher picks a descriptor directly (Nursery/KG)
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

enum FeeAppliesTo {
  ALL
  NEW_STUDENTS
  CONTINUING_STUDENTS
}

enum DiscountType {
  PERCENT
  FIXED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

enum InvoiceLineKind {
  FEE
  ARREARS
  DISCOUNT
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  BANK_DEPOSIT
  MOBILE_MONEY
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ───────────────────── Platform (your SaaS layer) ─────────────────────

model Plan {
  id                String         @id @default(cuid())
  name              String         @unique
  pricePerStudent   Decimal        @db.Decimal(12, 2)
  minimumPerTerm    Decimal        @default(0) @db.Decimal(12, 2)
  smsCreditsPerTerm Int            @default(0)
  maxStudents       Int?
  features          Json           @default("{}")
  isActive          Boolean        @default(true)
  subscriptions     Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  schoolId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  billedStudentCount Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan     Plan              @relation(fields: [planId], references: [id])
  invoices PlatformInvoice[]
}

model PlatformInvoice {
  id             String        @id @default(cuid())
  subscriptionId String
  periodLabel    String // e.g. "2026/2027 Term 1"
  amount         Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(ISSUED)
  dueDate        DateTime      @db.Date
  paidAt         DateTime?
  paymentRef     String?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ───────────────────────── Tenant & identity ─────────────────────────

model School {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique // subdomain: brightfuture.schoolos.app
  motto     String?
  logoUrl   String?
  emisCode  String? // GES/EMIS code, if the school has one
  region    String?
  district  String?
  town      String?
  address   String?
  phone     String?
  email     String?
  currency  String       @default("GHS")
  timezone  String       @default("Africa/Accra")
  status    SchoolStatus @default(PENDING)
  // Policy flags + display options: { withholdReportsIfOwing: bool, feeClearanceThreshold: number, smsSenderId: string, ... }
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  subscription  Subscription?
  memberships   Membership[]
  academicYears AcademicYear[]
  levels        Level[]
  classes       Class[]
  subjects      Subject[]
  students      Student[]
  guardians     Guardian[]
  staff         Staff[]
  applications  AdmissionApplication[]
  calendarDays  CalendarDay[]
  gradingScales GradingScale[]
  schemes       AssessmentScheme[]
  feeItems      FeeItem[]
  discounts     Discount[]
  invoices      Invoice[]
  payments      Payment[]
  messages      Message[]
  templates     MessageTemplate[]
  announcements Announcement[]
  smsLedger     SmsCreditEntry[]
  sequences     DocumentSequence[]
  auditLogs     AuditLog[]
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String?   @unique
  phone           String?   @unique // Ghana parents mostly sign in by phone (OTP)
  passwordHash    String?
  isPlatformAdmin Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
  staff       Staff[]
  guardians   Guardian[]
}

// One user can belong to several schools (e.g. a parent with children at two schools).
model Membership {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, role])
  @@index([schoolId, role])
}

// ───────────────────────── Academic structure ─────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // "2026/2027"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms         Term[]
  enrollments   Enrollment[]
  classSubjects ClassSubject[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Term {
  id               String    @id @default(cuid())
  schoolId         String
  academicYearId   String
  number           Int // 1, 2, 3
  name             String // "Term 1"
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  vacationDate     DateTime? @db.Date // printed on report card
  reopeningDate    DateTime? @db.Date // "Next term begins"
  daysOpenOverride Int? // manual override of "attendance out of"
  isCurrent        Boolean   @default(false)
  scoresLocked     Boolean   @default(false) // lock score entry after approval

  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendance   AttendanceRecord[]
  submissions  AttendanceSubmission[]
  scores       Score[]
  results      SubjectResult[]
  reports      TermReport[]
  invoices     Invoice[]
  feeLines     FeeStructureLine[]

  @@unique([academicYearId, number])
  @@index([schoolId, isCurrent])
}

model CalendarDay {
  id          String          @id @default(cuid())
  schoolId    String
  date        DateTime        @db.Date
  type        CalendarDayType
  description String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
}

model Level {
  id       String @id @default(cuid())
  schoolId String
  name     String // "Nursery 1", "KG 2", "Primary 4", "JHS 2"
  stage    Stage
  order    Int // for promotion: next level = order + 1

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes  Class[]
  feeLines FeeStructureLine[]
  schemes  AssessmentScheme[]

  @@unique([schoolId, name])
  @@index([schoolId, order])
}

model Class {
  id             String  @id @default(cuid())
  schoolId       String
  levelId        String
  name           String // "Primary 4 A"
  classTeacherId String?
  capacity       Int?

  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level         Level                  @relation(fields: [levelId], references: [id])
  classTeacher  Staff?                 @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  classSubjects ClassSubject[]
  attendance    AttendanceRecord[]
  submissions   AttendanceSubmission[]
  reports       TermReport[]

  @@unique([schoolId, name])
  @@index([schoolId, levelId])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  name     String // "Mathematics", "Our World Our People"
  code     String?
  isCore   Boolean @default(true)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]

  @@unique([schoolId, name])
}

// "Subject X is taught in Class Y during Year Z by Teacher T"
model ClassSubject {
  id             String  @id @default(cuid())
  classId        String
  subjectId      String
  academicYearId String
  teacherId      String?

  class        Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      Staff?          @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  scores       Score[]
  results      SubjectResult[]

  @@unique([classId, subjectId, academicYearId])
  @@index([teacherId])
}

// ───────────────────── People: students, guardians, staff ─────────────────────

model Student {
  id              String        @id @default(cuid())
  schoolId        String
  admissionNo     String // unique per school, generated from DocumentSequence
  firstName       String
  middleName      String?
  lastName        String
  gender          Gender
  dateOfBirth     DateTime      @db.Date
  photoUrl        String?
  nationality     String?       @default("Ghanaian")
  religion        String?
  hometown        String?
  homeAddress     String?
  medicalNotes    String?
  previousSchool  String?
  admissionDate   DateTime      @db.Date
  admittedLevelId String? // level at entry (drives NEW_STUDENTS fees)
  status          StudentStatus @default(ACTIVE)
  statusChangedAt DateTime?
  statusReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardians   StudentGuardian[]
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  scores      Score[]
  results     SubjectResult[]
  reports     TermReport[]
  invoices    Invoice[]
  payments    Payment[]
  discounts   StudentDiscount[]
  documents   StudentDocument[]
  application AdmissionApplication?
  messages    Message[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
}

model StudentDocument {
  id         String   @id @default(cuid())
  studentId  String
  kind       String // BIRTH_CERTIFICATE, TRANSFER_LETTER, PASSPORT_PHOTO, OTHER
  fileUrl    String
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String? // set once they get a portal login
  fullName   String
  phone      String // primary SMS/MoMo number, normalised to +233XXXXXXXXX
  altPhone   String?
  email      String?
  occupation String?
  address    String?
  createdAt  DateTime @default(now())

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]
  messages Message[]

  @@unique([schoolId, phone])
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String // Mother, Father, Uncle, Guardian…
  isPrimary    Boolean @default(false)
  isFeePayer   Boolean @default(false)
  canPickUp    Boolean @default(true)
  receivesSms  Boolean @default(true)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Staff {
  id            String    @id @default(cuid())
  schoolId      String
  userId        String?
  staffNo       String
  fullName      String
  gender        Gender?
  phone         String?
  email         String?
  jobTitle      String // "Class Teacher", "Headteacher", "Bursar"
  qualification String?
  employedOn    DateTime? @db.Date
  isActive      Boolean   @default(true)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  classesLed     Class[]        @relation("ClassTeacher")
  subjectsTaught ClassSubject[] @relation("SubjectTeacher")

  @@unique([schoolId, staffNo])
}

// ───────────────────────── Admissions & enrolment ─────────────────────────

model AdmissionApplication {
  id             String          @id @default(cuid())
  schoolId       String
  applicationNo  String
  childFirstName String
  childLastName  String
  gender         Gender
  dateOfBirth    DateTime        @db.Date
  appliedLevelId String
  guardianName   String
  guardianPhone  String
  guardianEmail  String?
  previousSchool String?
  notes          String?
  status         AdmissionStatus @default(SUBMITTED)
  decidedAt      DateTime?
  decisionNote   String?
  studentId      String?         @unique // set when converted to a Student
  createdAt      DateTime        @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status])
}

// Which class a student sits in for a given year. History = promotion trail.
model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  status         EnrollmentStatus @default(ENROLLED)
  rollNumber     Int?
  createdAt      DateTime         @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([classId, academicYearId])
}

// ───────────────────────────── Attendance ─────────────────────────────

model AttendanceRecord {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  classId    String
  termId     String
  date       DateTime         @db.Date
  status     AttendanceStatus
  remark     String?
  markedById String // User.id
  markedAt   DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, date])
  @@index([schoolId, classId, date])
  @@index([termId, studentId])
}

// "Register taken" marker: lets us show classes that have not submitted today.
model AttendanceSubmission {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  termId      String
  date        DateTime @db.Date
  submittedBy String
  submittedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  term  Term  @relation(fields: [termId], references: [id])

  @@unique([classId, date])
  @@index([schoolId, date])
}

// ───────────────────── Assessment, grading & report cards ─────────────────────

model GradingScale {
  id       String    @id @default(cuid())
  schoolId String
  name     String // "JHS (BECE 1–9)", "Primary", "KG Ratings"
  kind     ScaleKind

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bands   GradeBand[]
  schemes AssessmentScheme[]

  @@unique([schoolId, name])
}

model GradeBand {
  id       String   @id @default(cuid())
  scaleId  String
  grade    String // "1", "A", "HP"
  label    String // "Highest", "Advance"
  remark   String? // printed on the card
  minScore Decimal? @db.Decimal(5, 2) // null for RATING scales
  maxScore Decimal? @db.Decimal(5, 2)
  order    Int
  isPass   Boolean  @default(true)

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@index([scaleId, order])
}

// How a term mark is built for a level, e.g. Class Score 50 + Exam 50
model AssessmentScheme {
  id       String @id @default(cuid())
  schoolId String
  levelId  String
  scaleId  String
  name     String

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level      Level             @relation(fields: [levelId], references: [id])
  scale      GradingScale      @relation(fields: [scaleId], references: [id])
  components SchemeComponent[]

  @@unique([levelId])
}

model SchemeComponent {
  id       String  @id @default(cuid())
  schemeId String
  name     String // "Class Test 1", "Project", "End-of-term Exam"
  maxScore Decimal @db.Decimal(6, 2) // raw max the teacher enters against
  weight   Decimal @db.Decimal(5, 2) // contribution to the 100 total; weights must sum to 100
  order    Int

  scheme AssessmentScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  scores Score[]

  @@index([schemeId, order])
}

model Score {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  termId         String
  classSubjectId String
  componentId    String
  rawScore       Decimal? @db.Decimal(6, 2) // SCORE_BAND schemes
  ratingBandId   String? // RATING schemes (Nursery/KG)
  enteredById    String
  updatedAt      DateTime @updatedAt

  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term            @relation(fields: [termId], references: [id])
  classSubject ClassSubject    @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  component    SchemeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId, classSubjectId, componentId])
  @@index([termId, classSubjectId])
}

// Computed + cached per student/subject/term (recomputed when scores change).
model SubjectResult {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  termId          String
  classSubjectId  String
  totalScore      Decimal? @db.Decimal(5, 2)
  grade           String?
  gradeLabel      String?
  remark          String?
  subjectPosition Int?
  teacherComment  String?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id])
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId, classSubjectId])
  @@index([termId, classSubjectId])
}

model TermReport {
  id                 String       @id @default(cuid())
  schoolId           String
  studentId          String
  termId             String
  classId            String
  totalScore         Decimal?     @db.Decimal(7, 2)
  averageScore       Decimal?     @db.Decimal(5, 2)
  position           Int?
  classSize          Int?
  daysPresent        Int?
  daysOpen           Int?
  conduct            String?
  interest           String?
  attitude           String?
  classTeacherRemark String?
  headRemark         String?
  promotedToLevelId  String? // filled at end of Term 3
  status             ReportStatus @default(DRAFT)
  approvedById       String?
  publishedAt        DateTime?
  withheld           Boolean      @default(false) // fees policy
  withheldReason     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, termId])
  @@index([schoolId, termId, status])
}

// ───────────────────────────── Fees & payments ─────────────────────────────

model FeeItem {
  id         String  @id @default(cuid())
  schoolId   String
  name       String // Tuition, PTA, Feeding, Books, ICT, Uniform
  isOptional Boolean @default(false)
  isActive   Boolean @default(true)

  school School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lines  FeeStructureLine[]

  @@unique([schoolId, name])
}

// "In this term, level L is charged X for item I"
model FeeStructureLine {
  id        String       @id @default(cuid())
  schoolId  String
  termId    String
  levelId   String
  feeItemId String
  amount    Decimal      @db.Decimal(12, 2)
  appliesTo FeeAppliesTo @default(ALL)

  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  feeItem FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)

  @@unique([termId, levelId, feeItemId, appliesTo])
  @@index([schoolId, termId])
}

model Discount {
  id       String       @id @default(cuid())
  schoolId String
  name     String // "Sibling 10%", "Staff child", "Scholarship"
  type     DiscountType
  value    Decimal      @db.Decimal(12, 2)
  isActive Boolean      @default(true)

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students StudentDiscount[]

  @@unique([schoolId, name])
}

model StudentDiscount {
  id         String    @id @default(cuid())
  studentId  String
  discountId String
  note       String?
  startsOn   DateTime? @db.Date
  endsOn     DateTime? @db.Date

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([studentId, discountId])
}

model Invoice {
  id            String        @id @default(cuid())
  schoolId      String
  invoiceNo     String
  studentId     String
  termId        String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime?     @db.Date
  dueDate       DateTime?     @db.Date
  subtotal      Decimal       @default(0) @db.Decimal(12, 2) // fees + arrears + adjustments
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2) // denormalised from allocations
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id])
  term        Term                @relation(fields: [termId], references: [id])
  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([schoolId, invoiceNo])
  @@index([schoolId, termId, status])
  @@index([studentId, termId])
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  kind        InvoiceLineKind @default(FEE)
  feeItemId   String?
  description String
  quantity    Int             @default(1)
  unitAmount  Decimal         @db.Decimal(12, 2)
  amount      Decimal         @db.Decimal(12, 2) // negative for DISCOUNT lines

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  schoolId       String
  receiptNo      String
  studentId      String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(SUCCESS)
  momoNetwork    String? // MTN, TELECEL, AT
  reference      String? // bank slip no. / MoMo transaction id
  providerRef    String?       @unique // Paystack/Hubtel reference for online payments
  payerName      String?
  payerPhone     String?
  paidAt         DateTime      @default(now())
  receivedById   String? // null when paid online by a parent
  note           String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime      @default(now())

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id])
  allocations PaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId, paidAt])
  @@index([studentId])
}

// Splits one payment across invoices. Unallocated remainder = student credit.
model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(12, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ─────────────────────────── Communication ───────────────────────────

model MessageTemplate {
  id       String         @id @default(cuid())
  schoolId String
  key      String // ABSENT_ALERT, FEE_REMINDER, RECEIPT, REPORT_READY, GENERAL
  channel  MessageChannel @default(SMS)
  body     String // "Dear {guardian}, {student} was absent on {date}."

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key, channel])
}

model Message {
  id             String         @id @default(cuid())
  schoolId       String
  channel        MessageChannel
  recipientPhone String?
  recipientEmail String?
  guardianId     String?
  studentId      String?
  body           String
  status         MessageStatus  @default(QUEUED)
  providerId     String?
  segments       Int            @default(1) // SMS credits consumed
  error          String?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  batchId        String? // groups a bulk send
  createdById    String?

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  student  Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([batchId])
}

model SmsCreditEntry {
  id        String   @id @default(cuid())
  schoolId  String
  delta     Int // + top-up / included allowance, − consumption
  reason    String
  reference String?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

model Announcement {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  body        String
  audience    String    @default("ALL") // ALL | PARENTS | STAFF | CLASS:<id>
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, publishedAt])
}

// ───────────────────────────── Platform plumbing ─────────────────────────────

// Gap-free-ish counters for admission numbers, invoices, receipts: key like "receipt:2026"
model DocumentSequence {
  id       String @id @default(cuid())
  schoolId String
  key      String
  next     Int    @default(1)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  userId     String?
  action     String // payment.reverse, score.update, report.publish, student.status_change
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
}
