{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the app's own windows use the window controls, events, file dialogs and links.",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:default",
    "shell:default",
    "updater:default",
    "process:allow-restart"
  ]
}
